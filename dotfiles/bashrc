# ~/.bashrc
# .bash_profile sources this too, so this is the whole shell config.

# Homebrew first on PATH. Doing it here rather than only in a login file also
# undoes the PATH reordering macOS path_helper does inside tmux.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export EDITOR=nvim
export VISUAL=nvim
export GOPATH="$HOME/go"
export PATH="$HOME/bin:$HOME/.local/bin:$GOPATH/bin:$HOME/.krew/bin:$HOME/.cargo/bin:$PATH"
if [[ -d $HOME/.volta ]]; then
  export VOLTA_HOME="$HOME/.volta"
  export PATH="$VOLTA_HOME/bin:$PATH"
fi

# Everything below is for interactive shells only
[[ $- != *i* ]] && return

shopt -s checkwinsize histappend
shopt -s autocd 2>/dev/null
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth

stty -ixon     # free <C-s>/<C-q> for vim
stty -echoctl  # don't echo ^C
GPG_TTY=$(tty) && export GPG_TTY

# GNU ls (brew install coreutils on macOS) groups directories first; BSD ls just gets colour
if command -v gls >/dev/null; then
  alias ls='gls --color=auto --group-directories-first'
elif ls --version >/dev/null 2>&1; then
  alias ls='ls --color=auto --group-directories-first'
else
  export CLICOLOR=1
fi
alias grep='grep --color=auto'
alias cb='pbcopy'
alias did='docker_id'

# cd and ls in one
cl() {
  cd "${1:-$HOME}" && ls
}

docker_id() {
  docker ps | grep "$1" | cut -f1 -d" "
}

# Refresh SSH_AUTH_SOCK after re-attaching to tmux
r() {
  [[ -n $TMUX ]] || return 0
  local sock
  sock=$(tmux showenv SSH_AUTH_SOCK 2>/dev/null | cut -d= -f2)
  [[ -S $sock ]] && export SSH_AUTH_SOCK=$sock
}

listening() {
  if [[ $# -eq 0 ]]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P
  elif [[ $# -eq 1 ]]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P | grep -i --color "$1"
  else
    echo "Usage: listening [pattern]"
  fi
}

# kubernetes
kctx() {  # point ~/.kube/config at one of ~/.kube/kube-*, picked with fzf
  local kube
  kube=$(cd ~/.kube && ls kube-* | fzf) && ln -sf "$kube" ~/.kube/config
}
klctx() {  # export KUBECONFIG from a file in ~/Downloads (or "$1"; "-" means ~/.kube)
  local dir="${1:-$HOME/Downloads}" kube
  [[ ${1:-} == "-" ]] && dir="$HOME/.kube"
  kube=$(ls -pt "$dir" | grep -v / | fzf) && export KUBECONFIG="${dir%/}/$kube"
}
klbip() {  # klbip <namespace> <service>: load balancer address
  kubectl -n "$1" get svc "$2" -o jsonpath="{.status.loadBalancer.ingress[*]['ip', 'hostname']}"
}
knsresources() {  # every namespaced resource in a namespace
  kubectl api-resources --verbs=list --namespaced -o name \
    | xargs -n 1 kubectl get --show-kind --ignore-not-found -n "${1:-default}"
}
kpatchfinalizer() {  # kpatchfinalizer <namespace> <resource>: clear finalizers
  kubectl -n "$1" patch --type merge -p '{"metadata":{"finalizers":[]}}' "$2"
}

# Completion (brew install bash bash-completion@2) and fzf keys: <C-r> <C-t> **<Tab>
if (( BASH_VERSINFO[0] >= 4 )) && [[ -r ${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh ]]; then
  . "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh"
fi
# Apple's git keeps its completion outside bash-completion's search path
if [[ $(type -P git) == /usr/bin/git ]]; then
  for f in /Library/Developer/CommandLineTools /Applications/Xcode.app/Contents/Developer; do
    [[ -r $f/usr/share/git-core/git-completion.bash ]] && { . "$f/usr/share/git-core/git-completion.bash"; break; }
  done
  unset f
fi
command -v fzf >/dev/null && eval "$(fzf --bash)"

# Prompt
if command -v starship >/dev/null; then
  eval "$(starship init bash)"
else
  PS1='\n[\u@\h \W]\n\$ '
fi

# Machine or work specific things live outside the repo
[[ -f ~/.bashrc.local ]] && source ~/.bashrc.local
