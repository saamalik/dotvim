[user]
  name = Saad Malik
  email = saad@spectrocloud.com
[core]
  whitespace = cr-at-eol
  autocrlf = input
  ignorecase = false
  pager = less -x1,5
[init]
  defaultBranch = main
[column]
  ui = auto
[branch]
  sort = -committerdate
[diff]
  algorithm = histogram
[merge]
  conflictstyle = zdiff3
[pull]
  rebase = false
[push]
  default = simple
  autoSetupRemote = true
[fetch]
  prune = true
[rebase]
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
  autoupdate = true
[commit]
  verbose = true
[help]
  autocorrect = prompt
[url "git@github.com:"]
  insteadOf = https://github.com/
# Machine-specific overrides (another identity, signing setup, ...) stay out of git
[include]
  path = ~/.gitconfig.local
